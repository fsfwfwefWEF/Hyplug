{
  // Настройки отображения боя в Hytale. Копия этого файла лежит в папке данных мода
  // (mods/Hveien_JrpgBattles/settings.json), её можно править без пересборки: /jrpg reload.
  // Если в копии нет какого-то ключа, берётся значение по умолчанию.

  // Роли NPC Hytale для компаньонов (герой — сам игрок). Список ролей в игре: /jrpg roles <часть имени>.
  "companionRoles": { "lyra": "Kweebec_Seedling", "bram": "Trork_Warrior" },
  // Роль, которой изображается враг/компаньон, если его роль в игре не нашлась.
  "fallbackRole": "Trork_Warrior",

  // Камера боя. Углы в градусах (pitch минус — взгляд сверху), расстояния в блоках.
  // overview — общий план арены, focus — наезд на того, чей ход, action — кадр «атакующий + цель»,
  // targetDistance — кадр выбора цели. side — насколько камера заходит сбоку (0 — строго сзади партии).
  // minHeight — камера не опускается ниже стольких блоков над точкой взгляда (не влезает в модели).
  // flip: true — камера с другой стороны арены. Если камера всё равно слишком близко — увеличь distance.
  "camera": {
    "enabled": true,
    "lerp": 0.1,
    "flip": false,
    "minHeight": 3.5,
    "targetDistance": 15,
    "overview": { "distance": 20, "pitch": -38, "side": 55 },
    "focus":    { "distance": 11, "pitch": -28, "side": 45 },
    "action":   { "distance": 10, "pitch": -30, "side": 75 }
  },

  // Интерфейс: icons — картинки иконок, bars — полоски HP/MP. Если меню не открывается
  // или вместо картинок ошибки — поставь false и сделай /jrpg reload.
  "ui": { "icons": true, "bars": true },

  // Частицы: кольцо под тем, чей ход / под целью, и эффект удара. Имена — id ассетов ParticleSystem
  // из Assets.zip игры (пустая строка — выключено). Проверить имя в игре: /jrpg particle <имя>.
  "particles": { "turnRing": "", "targetRing": "", "hit": "" },

  // Паузы (мс): показ результата действия и «раздумья» врага перед ударом (камера в это время на нём).
  "actionDelayMs": 2400,
  "enemyThinkMs": 1500,
  // Общая скорость боя: 1 — обычная, 1.5 — быстрее, 0.7 — медленнее (делит все паузы).
  "battleSpeed": 1.0,
  // Всплывающие цифры урона, лечения и названия эффектов над бойцами.
  "combatText": true,

  // Анимации атак: берётся первое имя из списка, которое есть у модели NPC (настоящие имена мод пишет
  // в лог сервера строкой «Анимации модели ...»). stepCount/stepMs — плавность подхода к цели.
  "animations": {
    "enabled": true,
    "attack": ["Attack", "Swing", "Slash", "Strike", "Punch", "Bite", "Melee", "Hit"],
    "cast": ["Cast", "Spell", "Magic", "Shoot", "Throw", "Roar", "Attack"],
    "hurt": ["Hurt", "Damage", "Flinch"],
    "death": ["Death", "Die"],
    "victory": ["Cheer", "Celebrate", "Victory", "Wave", "Emote", "Roar"],
    "stepCount": 5,
    "stepMs": 70
  },

  // Автостарт боя, когда игрок подходит к встрече из encounters.json или к отряду из squads.json.
  "proximityTrigger": true,
  // Окно «Сражаться / Сбежать» перед боем (false — бой сразу).
  "preBattlePrompt": true,
  // Облёт камеры вокруг арены перед первым ходом.
  "introFlyby": true
}
