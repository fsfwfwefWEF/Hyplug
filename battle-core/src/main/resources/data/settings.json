{
  // Настройки отображения боя в Hytale. Копия этого файла появляется в папке данных мода,
  // её можно править без пересборки (перезапуск сервера или /jrpg reload).

  // Роли NPC Hytale для компаньонов (герой — сам игрок). Если роль не найдена — компаньон
  // остаётся только в меню, а в лог пишется предупреждение.
  "companionRoles": { "lyra": "Kweebec_Seedling", "bram": "Trork_Warrior" },

  // Камера боя: расстояние, наклон (градусы, минус — взгляд сверху), поворот (градусы).
  "camera": { "distance": 13, "pitch": -35, "yaw": 0, "lerp": 0.08, "enabled": true },

  // Частицы: кольцо под тем, чей ход / под целью, и эффект удара. Имена — id ассетов ParticleSystem
  // из Assets.zip игры (пустая строка — выключено). Проверить имя в игре: /jrpg particle <имя>.
  "particles": { "turnRing": "", "targetRing": "", "hit": "" },

  // Паузы (мс): сколько показывать результат действия перед следующим ходом.
  "actionDelayMs": 1400,
  "enemyThinkMs": 700,

  // Автостарт боя, когда игрок подходит к встрече из encounters.json.
  "proximityTrigger": true
}
