{
  "_version": 3,

  "_casters": {"meteor": "lyra", "bleeding_cut": "bram", "fire_slash": "hero", "whirlwind": "hero", "fireball": "lyra", "mass_cure": "lyra", "ground_slam": "bram", "war_cry": "bram"},

  "_about": "Сцены навыков. Ключ = id способности (полная сцена, как meteor и bleeding_cut). Остальные навыки играются по шаблонам (_templates): шаблон и его параметры задаются в _skills, иначе подбираются сами по навыку (ближний/по всем/снаряд/лечение/усиление). Параметры в шаблоне пишутся {имя}: color, charge (замах-зарядка), release (выпуск магии), strike (удар), aura (частицы на оружии), fx (частицы попадания), vfx (фигура эффекта: flame, fireball, ice, lightning, water, earth, poison, acid, heal, buff, haste, guard, taunt, slash, shadow, meteor), lead (мс полёта фигуры). Пустой параметр убирает действие. anim: weapon:Имя — анимация оружия в руке, model:attack|cast|hurt — общие имена модели из settings.json, emote:Имя — эмоция. Имена с @ — частицы ParticleCatalog. t в мс, '+N' — от предыдущего шага.",

  "_defaults": {"color": "#ffd27a", "charge": "weapon:CastLeftCharged", "release": "weapon:CastSummon", "strike": "weapon:SwingDownStrong", "aura": "@cast"},

  "_templates": {
    "melee": [
      {"t": 0, "camera": "focus", "on": "caster", "dist": 3.0, "height": 1.5, "side": 35, "ms": 500},
      {"t": 80, "anim": "{charge}", "fallback": ["weapon:CastLeftCharged", "weapon:CastEnrage", "weapon:CastSummonCharged", "weapon:CastEnchant", "model:cast"], "on": "caster"},
      {"t": 150, "glow": {"color": "{color}", "thickness": 0.8, "bloom": true}, "on": "caster", "ms": 900},
      {"t": 200, "particles": "{aura}", "fallback": ["@cast"], "on": "caster", "attach": "PrimaryItem", "offset": [0, 0.8, 0], "color": "{color}"},
      {"t": 800, "camera": "follow", "on": "caster", "dist": 4, "height": 2, "ms": 0},
      {"t": 800, "move": "run", "to": "target", "stopAt": 1.6},
      {"wait": "arrived"},
      {"anim": "{strike}", "fallback": ["weapon:SwingDownStrong", "weapon:SwingDown", "weapon:SwingLeft", "model:attack"], "on": "caster"},
