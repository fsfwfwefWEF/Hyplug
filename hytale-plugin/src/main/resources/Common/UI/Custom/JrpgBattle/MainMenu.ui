$C = "../Common.ui";

// Меню героя на клавише режима (MainMenuPage). Кнопки: #Party, #Gear, #Bag, #Follow, #Mode, #Close;
// тексты #Follow и #Mode ставит код. Собрано tools/gen_battle_ui.py — правь скрипт.

Group {
  LayoutMode: Top;

  Group { FlexWeight: 1; }
  Group {
    Anchor: (Height: 486);
    LayoutMode: Left;

    Group { FlexWeight: 1; }
    Group #WindowSlot {
      Anchor: (Width: 450);

      Group #Window {
        Anchor: (Left: 0, Top: 0, Width: 450, Height: 486);
        LayoutMode: Top;
        Background: (TexturePath: "jr_window.png", Border: 86);
        Padding: (Left: 24, Right: 24, Top: 16, Bottom: 24);

        Group {
          Anchor: (Height: 52);
          LayoutMode: Left;

          Group { FlexWeight: 1; }
          Group {
            Anchor: (Width: 400, Height: 52);
            LayoutMode: Top;
            Background: (TexturePath: "jr_banner.png");
            Padding: (Top: 6);

            Label {
              Text: "МЕНЮ ГЕРОЯ";
              Anchor: (Height: 26);
              Style: (FontSize: 21, TextColor: #e8c46a, RenderBold: true, HorizontalAlignment: Center);
            }
            Label #Sub {
              Text: "клавиша O · креатив — кнопкой «Режим игры»";
              Anchor: (Height: 16);
              Style: (FontSize: 12, TextColor: #b4c2d6, HorizontalAlignment: Center);
            }
          }
          Group { FlexWeight: 1; }
        }
        Group { Anchor: (Height: 4); }
        Group {
          Anchor: (Height: 344);
          LayoutMode: Top;
          Background: (TexturePath: "jr_panel.png", Border: 22);
          Padding: (Full: 14);

          Group {
            Anchor: (Height: 46);
            LayoutMode: Left;

            Group {
              Anchor: (Width: 46, Height: 46);
              Background: (TexturePath: "jr_slot.png", Border: 8);

              Group { Anchor: (Left: 5, Top: 5, Width: 36, Height: 36); Background: (TexturePath: "Icons/levelup.png"); }
            }
            Group { Anchor: (Width: 8); }
            $C.@SecondaryTextButton #Party { @Text = "Прокачка партии"; Anchor: (Width: 316, Height: 42); }
          }
          Group { Anchor: (Height: 6); }
          Group {
            Anchor: (Height: 46);
            LayoutMode: Left;

            Group {
              Anchor: (Width: 46, Height: 46);
              Background: (TexturePath: "jr_slot.png", Border: 8);

              Group { Anchor: (Left: 5, Top: 5, Width: 36, Height: 36); Background: (TexturePath: "Icons/sword.png"); }
            }
            Group { Anchor: (Width: 8); }
            $C.@SecondaryTextButton #Gear { @Text = "Экипировка"; Anchor: (Width: 316, Height: 42); }
          }
          Group { Anchor: (Height: 6); }
          Group {
            Anchor: (Height: 46);
            LayoutMode: Left;

            Group {
              Anchor: (Width: 46, Height: 46);
              Background: (TexturePath: "jr_slot.png", Border: 8);

              Group { Anchor: (Left: 5, Top: 5, Width: 36, Height: 36); Background: (TexturePath: "Icons/bag.png"); }
            }
            Group { Anchor: (Width: 8); }
            $C.@SecondaryTextButton #Bag { @Text = "Рюкзак"; Anchor: (Width: 316, Height: 42); }
          }
          Group { Anchor: (Height: 6); }
          Group {
            Anchor: (Height: 46);
            LayoutMode: Left;

            Group {
              Anchor: (Width: 46, Height: 46);
              Background: (TexturePath: "jr_slot.png", Border: 8);

              Group { Anchor: (Left: 5, Top: 5, Width: 36, Height: 36); Background: (TexturePath: "Icons/pt_bram.png"); }
            }
            Group { Anchor: (Width: 8); }
            $C.@SecondaryTextButton #Follow { @Text = "Компаньоны"; Anchor: (Width: 316, Height: 42); }
          }
          Group { Anchor: (Height: 6); }
          Group {
            Anchor: (Height: 46);
            LayoutMode: Left;

            Group {
              Anchor: (Width: 46, Height: 46);
              Background: (TexturePath: "jr_slot.png", Border: 8);

              Group { Anchor: (Left: 5, Top: 5, Width: 36, Height: 36); Background: (TexturePath: "Icons/info.png"); }
            }
            Group { Anchor: (Width: 8); }
            $C.@SecondaryTextButton #Mode { @Text = "Режим игры"; Anchor: (Width: 316, Height: 42); }
          }
          Group { Anchor: (Height: 6); }
          Group { Anchor: (Height: 4); }
          Group { Anchor: (Height: 1); Background: #e8c46a(0.40); }
          Group { Anchor: (Height: 1); Background: #000000(0.35); }
          Group { Anchor: (Height: 8); }
          Group {
            Anchor: (Height: 42);
            LayoutMode: Left;

            Group { FlexWeight: 1; }
            $C.@CancelTextButton #Close { @Text = "Закрыть"; Anchor: (Width: 260, Height: 42); }
            Group { FlexWeight: 1; }
          }
        }
      }
    }
    Group { FlexWeight: 1; }
  }
  Group { FlexWeight: 1; }
}
