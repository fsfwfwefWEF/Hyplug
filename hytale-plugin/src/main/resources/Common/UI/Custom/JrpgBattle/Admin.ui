$C = "../Common.ui";

// Админ-меню (AdminPage): разделы #Tab0..6 (метка #Tab<i>Mark), строки #Row<i> с кнопками #Act<i>/#Alt<i>
// (#AltBox<i> прячет вторую кнопку) и подсказкой #Hint<i>; #SecTitle, #SecSub, #Prev/#Page/#Next, #Status, #Close.
// Собрано tools/gen_battle_ui.py — правь скрипт.

Group {
  LayoutMode: Top;

  Group { FlexWeight: 1; }
  Group {
    Anchor: (Height: 764);
    LayoutMode: Left;

    Group { FlexWeight: 1; }
    Group #WindowSlot {
      Anchor: (Width: 1000);

      Group #Window {
        Anchor: (Left: 0, Top: 0, Width: 1000, Height: 764);
        LayoutMode: Top;
        Background: (TexturePath: "jr_window.png", Border: 86);
        Padding: (Left: 24, Right: 24, Top: 16, Bottom: 24);

        Group {
          Anchor: (Height: 52);
          LayoutMode: Left;

          Group { FlexWeight: 1; }
          Group {
            Anchor: (Width: 520, Height: 52);
            LayoutMode: Top;
            Background: (TexturePath: "jr_banner.png");
            Padding: (Top: 6);

            Label {
              Text: "АДМИН-МЕНЮ";
              Anchor: (Height: 26);
              Style: (FontSize: 21, TextColor: #e8c46a, RenderBold: true, HorizontalAlignment: Center);
            }
            Label #Sub {
              Text: "/jrpg admin · кнопка «Админ-меню» в меню героя (O)";
              Anchor: (Height: 16);
              Style: (FontSize: 12, TextColor: #b4c2d6, HorizontalAlignment: Center);
            }
          }
          Group { FlexWeight: 1; }
        }
        Group { Anchor: (Height: 6); }
        Group {
          Anchor: (Height: 602);
          LayoutMode: Left;

