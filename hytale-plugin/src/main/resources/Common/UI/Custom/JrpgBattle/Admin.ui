              Anchor: (Height: 20);
              Style: (FontSize: 13, TextColor: #e8c46a, RenderBold: true);
            }
            Group { Anchor: (Height: 6); }
            Group {
              Anchor: (Height: 40);
              LayoutMode: Left;

              Label #Tab0Mark {
                Text: "";
                Anchor: (Width: 18, Height: 40);
                Style: (FontSize: 16, TextColor: #e8c46a, RenderBold: true);
              }
              $C.@SecondaryTextButton #Tab0 { @Text = "Катсцены"; Anchor: (Width: 164, Height: 38); }
            }
            Group { Anchor: (Height: 6); }
