$C = "../Common.ui";

// Экипировка: вкладки героев #Tab0..2, слоты #Slot0..7 (#Slot<n>Sel, #Slot<n>Btn, #Slot<n>Icon), вещи из
// рюкзака #Item0..7 (+ #Item<n>Q — качество, #Item<n>Icon), сравнение #Cmp0..11 и #CmpIcon,
// кнопки #Equip/#Unequip/#Back/#Close. Собрано tools/gen_battle_ui.py — правь скрипт.

Group {
  LayoutMode: Top;

  Group { FlexWeight: 1; }
  Group {
    Anchor: (Height: 614);
    LayoutMode: Left;

    Group { FlexWeight: 1; }
    Group #WindowSlot {
      Anchor: (Width: 1150);

      Group #Window {
        Anchor: (Left: 0, Top: 0, Width: 1150, Height: 614);
        LayoutMode: Top;
        Background: (TexturePath: "jr_window.png", Border: 86);
        Padding: (Left: 24, Right: 24, Top: 16, Bottom: 24);

        Group {
          Anchor: (Height: 52);
          LayoutMode: Left;

          Group { FlexWeight: 1; }
          Group {
            Anchor: (Width: 560, Height: 52);
            LayoutMode: Top;
            Background: (TexturePath: "jr_banner.png");
            Padding: (Top: 6);

            Label {
              Text: "ЭКИПИРОВКА";
              Anchor: (Height: 26);
              Style: (FontSize: 21, TextColor: #e8c46a, RenderBold: true, HorizontalAlignment: Center);
            }
            Label {
              Text: "оружие, броня и аксессуары партии";
              Anchor: (Height: 16);
              Style: (FontSize: 12, TextColor: #b4c2d6, HorizontalAlignment: Center);
            }
          }
          Group { FlexWeight: 1; }
        }
        Group #Tabs {
          Anchor: (Height: 34);
          LayoutMode: Left;

          $C.@SecondaryTextButton #Tab0 { @Text = ""; Anchor: (Width: 200, Height: 32); }
          Group { Anchor: (Width: 6); }
          $C.@SecondaryTextButton #Tab1 { @Text = ""; Anchor: (Width: 200, Height: 32); }
          Group { Anchor: (Width: 6); }
          $C.@SecondaryTextButton #Tab2 { @Text = ""; Anchor: (Width: 200, Height: 32); }
          Group { Anchor: (Width: 6); }
          Group { FlexWeight: 1; }
          Label #Hint {
            Text: "";
            Anchor: (Width: 330, Height: 32);
            Style: (FontSize: 12, TextColor: #b4c2d6, Wrap: true);
          }
        }
        Group { Anchor: (Height: 8); }
        Group {
