$C = "../Common.ui";

// Экипировка: вкладки героев #Tab0..2, слоты #Slot0..7 (#Slot<n>Sel, #Slot<n>Btn), вещи из рюкзака
// #Item0..7 (+ #Item<n>Q — качество), сравнение #Cmp0..11, кнопки #Equip/#Unequip/#Back/#Close.
// Собрано tools/gen_battle_ui.py — правь скрипт.

Group {
  LayoutMode: Top;

  Group { FlexWeight: 1; }
  Group {
    Anchor: (Height: 532);
    LayoutMode: Left;

    Group { FlexWeight: 1; }
    Group #Window {
      Anchor: (Width: 1130);
      LayoutMode: Top;
      Background: #070b12(0.95);
      Padding: (Full: 12);

      Group {
        Anchor: (Height: 32);
        LayoutMode: Left;

        Label {
          Text: "ЭКИПИРОВКА";
          Anchor: (Height: 30);
          FlexWeight: 1;
          Style: (FontSize: 22, TextColor: #e8c46a, RenderBold: true);
        }
      }
      Group #Tabs {
        Anchor: (Height: 34);
        LayoutMode: Left;

        $C.@SecondaryTextButton #Tab0 { @Text = ""; Anchor: (Width: 200, Height: 32); }
        Group { Anchor: (Width: 6); }
        $C.@SecondaryTextButton #Tab1 { @Text = ""; Anchor: (Width: 200, Height: 32); }
        Group { Anchor: (Width: 6); }
        $C.@SecondaryTextButton #Tab2 { @Text = ""; Anchor: (Width: 200, Height: 32); }
        Group { Anchor: (Width: 6); }
        Group { FlexWeight: 1; }
        Label #Hint {
          Text: "";
