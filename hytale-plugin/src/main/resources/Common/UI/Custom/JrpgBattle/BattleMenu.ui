$C = "../Common.ui";

// Боевое меню JRPG. Файл собран скриптом tools/gen_battle_ui.py — правь скрипт, а не этот файл.
// Сверху враги, справа осмотр бойца, внизу партия, команды и описание. Баннер хода, очередь и
// журнал-книга обычно в HUD (BattleHud.ui); здесь их запасной вид для settings.json → ui.hud = false.
// Рамки — текстуры jr_*.png (tools/gen_frames.py), иконки вставляются в слоты #...Icon из Icons/*.ui.

Group {

  Group #HitLayer0 {
    Anchor: (Full: 0);
    LayoutMode: Top;

    Group #Hit0Top { Anchor: (Height: 400); }
    Group #Hit0Row {
      Anchor: (Height: 180);
      LayoutMode: Left;

      Group #Hit0Left { Anchor: (Width: 800); }
      Button #Hit0 { Anchor: (Width: 140, Height: 180); }
      Group { FlexWeight: 1; }
    }
    Group { FlexWeight: 1; }
  }
  Group #HitLayer1 {
    Anchor: (Full: 0);
    LayoutMode: Top;

