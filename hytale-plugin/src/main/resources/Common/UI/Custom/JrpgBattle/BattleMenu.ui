        Anchor: (Height: 42);
        LayoutMode: Left;

        Group #Opt4Icon { Anchor: (Width: 40, Height: 40); }
        Group { Anchor: (Width: 6); }
        $C.@SecondaryTextButton #Opt4 { @Text = ""; Anchor: (Width: 250, Height: 38); }
        Group { Anchor: (Width: 6); }
        Label #Opt4Hint {
          Text: "";
          Anchor: (Width: 90, Height: 38);
          Style: (FontSize: 13, TextColor: #e8c46a);
        }
      }
      Group #Row5 {
        Anchor: (Height: 42);
        LayoutMode: Left;

        Group #Opt5Icon { Anchor: (Width: 40, Height: 40); }
        Group { Anchor: (Width: 6); }
        $C.@SecondaryTextButton #Opt5 { @Text = ""; Anchor: (Width: 250, Height: 38); }
        Group { Anchor: (Width: 6); }
        Label #Opt5Hint {
          Text: "";
          Anchor: (Width: 90, Height: 38);
          Style: (FontSize: 13, TextColor: #e8c46a);
        }
      }
      Group { Anchor: (Height: 4); }
      $C.@CancelTextButton #Back { @Text = "Назад"; Anchor: (Height: 32); }
      Label #Error {
        Text: "";
        Anchor: (Height: 22);
        Style: (FontSize: 13, TextColor: #ff7070);
      }
    }
  }
}
