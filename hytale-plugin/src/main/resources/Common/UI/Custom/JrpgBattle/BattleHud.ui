    Label #HBookR { Text: ""; Anchor: (Left: 238, Top: 38, Width: 176, Height: 210); Style: (FontSize: 13, TextColor: #3a2a1a, Wrap: true); }
    Label #HBookLNum { Text: ""; Anchor: (Left: 28, Top: 260, Width: 176, Height: 14); Style: (FontSize: 11, TextColor: #8a7050, HorizontalAlignment: Center); }
