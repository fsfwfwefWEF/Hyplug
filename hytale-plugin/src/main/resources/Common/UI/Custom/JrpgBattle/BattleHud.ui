$C = "../Common.ui";

// HUD боя: баннер хода #HBannerRow, очередь #HQueue (#HQ0..7, фоны #HQ<n>Cur/Pty/Ene), книга журнала #HBook
// (страницы #HBookL/#HBookR, лист #HFlip). Положение элементов плагин меняет шагами — это анимации.
// Собрано tools/gen_battle_ui.py — правь скрипт.

Group {
  Anchor: (Full: 0);

  Group #HBannerRow {
    Anchor: (Left: 0, Right: 0, Top: 96, Height: 62);
    LayoutMode: Left;

    Group { FlexWeight: 1; }
    Group #HBannerBox {
      Anchor: (Width: 600, Height: 60);
      LayoutMode: Top;
      Background: (TexturePath: "jr_banner.png");
      Padding: (Top: 8);

      Label #HBanner {
        Text: "";
        Anchor: (Height: 27);
        Style: (FontSize: 22, TextColor: #e8c46a, RenderBold: true, HorizontalAlignment: Center);
      }
      Label #HBannerSub {
        Text: "";
        Anchor: (Height: 18);
        Style: (FontSize: 13, TextColor: #e9eef6, HorizontalAlignment: Center);
      }
    }
    Group { FlexWeight: 1; }
  }
  Group #HQueue {
    Anchor: (Left: 12, Top: 170, Width: 236, Height: 382);
    Background: (TexturePath: "jr_panel.png", Border: 22);

    Label #HQueueTitle { Text: "ОЧЕРЕДЬ ХОДОВ"; Anchor: (Left: 16, Top: 12, Width: 200, Height: 20); Style: (FontSize: 13, TextColor: #e8c46a, RenderBold: true); }
    Group #HQ0 {
      Anchor: (Left: 11, Top: 38, Width: 214, Height: 50);

      Group #HQ0Cur { Anchor: (Left: 0, Top: 0, Width: 214, Height: 50); Background: (TexturePath: "jr_q_cur.png"); }
      Group #HQ0Pty { Anchor: (Left: 0, Top: 0, Width: 214, Height: 50); Background: (TexturePath: "jr_q_party.png"); }
      Group #HQ0Ene { Anchor: (Left: 0, Top: 0, Width: 214, Height: 50); Background: (TexturePath: "jr_q_enemy.png"); }
      Group {
        Anchor: (Left: 12, Top: 0, Width: 196, Height: 50);
        LayoutMode: Left;

        Group {
          LayoutMode: Top;
          Anchor: (Width: 38);

          Group { FlexWeight: 1; }
          Group #HQ0Icon { Anchor: (Width: 38, Height: 38); }
          Group { FlexWeight: 1; }
        }
        Group { Anchor: (Width: 8); }
        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Group { FlexWeight: 1; }
          Label #HQ0Name {
            Text: "";
            Anchor: (Height: 19);
            Style: (FontSize: 15, TextColor: #e9eef6, RenderBold: true);
          }
          Label #HQ0Sub {
            Text: "";
            Anchor: (Height: 15);
            Style: (FontSize: 12, TextColor: #e8c46a);
          }
