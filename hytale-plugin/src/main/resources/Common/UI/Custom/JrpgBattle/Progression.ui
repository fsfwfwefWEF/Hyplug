            LayoutMode: Left;
            Background: #141d2e(0.92);
            Padding: (Full: 6);

            Group #Node2Icon { Anchor: (Width: 40, Height: 40); }
            Group { Anchor: (Width: 8); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;

              Label #Node2Name {
                Text: "";
                Anchor: (Height: 22);
                Style: (FontSize: 16, TextColor: #e8c46a, RenderBold: true);
              }
              Label #Node2Text {
                Text: "";
                FlexWeight: 1;
                Style: (FontSize: 12, TextColor: #e9eef6, Wrap: true);
              }
            }
            Group { Anchor: (Width: 8); }
            Group {
              Anchor: (Width: 150);
              LayoutMode: Top;

              Label #Node2State {
                Text: "";
                Anchor: (Height: 30);
                Style: (FontSize: 12, TextColor: #9fb0c6, Wrap: true);
              }
              $C.@SecondaryTextButton #Learn2 { @Text = "Изучить"; Anchor: (Height: 34); }
            }
          }
          Group { Anchor: (Height: 6); }
          Group #Node3 {
            Anchor: (Height: 86);
            LayoutMode: Left;
            Background: #141d2e(0.92);
            Padding: (Full: 6);

            Group #Node3Icon { Anchor: (Width: 40, Height: 40); }
            Group { Anchor: (Width: 8); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;

              Label #Node3Name {
                Text: "";
                Anchor: (Height: 22);
                Style: (FontSize: 16, TextColor: #e8c46a, RenderBold: true);
              }
              Label #Node3Text {
                Text: "";
                FlexWeight: 1;
                Style: (FontSize: 12, TextColor: #e9eef6, Wrap: true);
