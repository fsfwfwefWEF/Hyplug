          Group { Anchor: (Width: 10); }
          Group #DetailCol {
            FlexWeight: 1;
            LayoutMode: Top;
            Background: (TexturePath: "jr_panel.png", Border: 22);
            Padding: (Full: 10);

            Group {
              Anchor: (Height: 44);
              LayoutMode: Left;

              Group #SelIcon { Anchor: (Width: 40, Height: 40); }
              Group { Anchor: (Width: 8); }
              Group {
                FlexWeight: 1;
                LayoutMode: Top;

                Label #SelTitle {
                  Text: "";
                  Anchor: (Height: 22);
                  Style: (FontSize: 16, TextColor: #e8c46a, RenderBold: true);
                }
                Label #SelKind {
                  Text: "";
                  Anchor: (Height: 18);
                  Style: (FontSize: 12, TextColor: #b4c2d6);
                }
              }
            }
            Group { Anchor: (Height: 4); }
            Group { Anchor: (Height: 1); Background: #e8c46a(0.40); }
            Group { Anchor: (Height: 1); Background: #000000(0.35); }
            Group { Anchor: (Height: 6); }
            Label #SelText {
              Text: "";
              FlexWeight: 1;
              Style: (FontSize: 12, TextColor: #e9eef6, Wrap: true);
            }
            Group {
              Anchor: (Height: 30);
              LayoutMode: Left;

              $C.@SecondaryTextButton #PrevNode { @Text = "<"; Anchor: (Width: 60, Height: 28); }
              Group { Anchor: (Width: 6); }
              Label {
                Text: "соседние узлы";
                Anchor: (Height: 28);
                FlexWeight: 1;
                Style: (FontSize: 12, TextColor: #b4c2d6);
              }
              $C.@SecondaryTextButton #NextNode { @Text = ">"; Anchor: (Width: 60, Height: 28); }
            }
            Group { Anchor: (Height: 6); }
            $C.@SecondaryTextButton #Learn { @Text = "Открыть узел"; Anchor: (Width: 250, Height: 34); }
            Group { Anchor: (Height: 4); }
            Label #Message {
              Text: "";
              Anchor: (Height: 36);
              Style: (FontSize: 12, TextColor: #ffd27a, Wrap: true);
            }
            Group { Anchor: (Height: 4); }
            $C.@CancelTextButton #Close { @Text = "Закрыть"; Anchor: (Width: 250, Height: 32); }
          }
        }
      }
    }
    Group { FlexWeight: 1; }
  }
  Group { FlexWeight: 1; }
}
