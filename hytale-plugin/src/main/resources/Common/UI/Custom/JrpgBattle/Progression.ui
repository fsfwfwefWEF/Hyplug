$C = "../Common.ui";

// Круговая сетка навыков. Собрано tools/gen_battle_ui.py — правь скрипт.
// Узел #G<n>: слои #G<n>Sel (выбран), #G<n>Lock/Avail/Open (состояние), кнопка #G<n>Btn, иконка #G<n>Icon.
// Рёбра: серые точки #EdgesOff всегда, золотые #Edge<k> — когда оба конца открыты.

Group {
  LayoutMode: Top;

  Group { FlexWeight: 1; }
  Group {
    Anchor: (Height: 750);
    LayoutMode: Left;

    Group { FlexWeight: 1; }
    Group #Window {
      Anchor: (Width: 1250);
      LayoutMode: Top;
      Background: #070b12(0.95);
      Padding: (Full: 12);

      Group {
        Anchor: (Height: 32);
        LayoutMode: Left;

        Label {
          Text: "СЕТКА НАВЫКОВ";
          Anchor: (Height: 30);
          FlexWeight: 1;
          Style: (FontSize: 22, TextColor: #e8c46a, RenderBold: true);
        }
        Label {
          Text: "открывай узлы рядом с уже открытыми";
          Anchor: (Width: 330, Height: 30);
          Style: (FontSize: 12, TextColor: #9fb0c6);
        }
      }
      Group #Tabs {
        Anchor: (Height: 34);
        LayoutMode: Left;

        $C.@SecondaryTextButton #Tab0 { @Text = ""; Anchor: (Width: 190, Height: 32); }
        Group { Anchor: (Width: 6); }
        $C.@SecondaryTextButton #Tab1 { @Text = ""; Anchor: (Width: 190, Height: 32); }
        Group { Anchor: (Width: 6); }
        $C.@SecondaryTextButton #Tab2 { @Text = ""; Anchor: (Width: 190, Height: 32); }
        Group { Anchor: (Width: 6); }
        Group { FlexWeight: 1; }
        Label #Points {
          Text: "";
          Anchor: (Width: 260, Height: 32);
          Style: (FontSize: 15, TextColor: #e8c46a, RenderBold: true);
        }
      }
      Group { Anchor: (Height: 8); }
      Group {
        Anchor: (Height: 640);
        LayoutMode: Left;

        Group #HeroCol {
          Anchor: (Width: 290);
          LayoutMode: Top;
          Background: #141d2e(0.88);
          Padding: (Full: 10);

          Group {
            Anchor: (Height: 92);
            LayoutMode: Left;

            Group #HeroIcon { Anchor: (Width: 88, Height: 88); }
            Group { Anchor: (Width: 10); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;

              Label #HeroName {
                Text: "";
                Anchor: (Height: 28);
                Style: (FontSize: 20, TextColor: #e9eef6, RenderBold: true);
              }
              Label #HeroTitle {
                Text: "";
                Anchor: (Height: 20);
                Style: (FontSize: 13, TextColor: #e8c46a);
              }
              Label #HeroLevel {
                Text: "";
                Anchor: (Height: 36);
                Style: (FontSize: 12, TextColor: #9fb0c6, Wrap: true);
              }
            }
          }
          Group #ExpBack {
            Anchor: (Width: 266, Height: 6);
            LayoutMode: Left;
            Background: #2a2410;
            Group #ExpFill { Anchor: (Width: 266, Height: 6); Background: #e8c46a; }
          }
          Group { Anchor: (Height: 8); }
          Label #HeroStats {
            Text: "";
            Anchor: (Height: 96);
            Style: (FontSize: 12, TextColor: #e9eef6, Wrap: true);
          }
          Label #HeroPassives {
            Text: "";
            Anchor: (Height: 60);
            Style: (FontSize: 12, TextColor: #c58cff, Wrap: true);
          }
          Label #Known {
            Text: "";
            FlexWeight: 1;
            Style: (FontSize: 12, TextColor: #9fb0c6, Wrap: true);
          }
          $C.@SecondaryTextButton #AddExp { @Text = "+100 опыта (тест)"; Anchor: (Width: 266, Height: 30); }
          Group { Anchor: (Height: 4); }
          $C.@SecondaryTextButton #Respec { @Text = "Сбросить сетку"; Anchor: (Width: 266, Height: 30); }
        }
        Group { Anchor: (Width: 10); }
        Group #Grid {
          Anchor: (Width: 640, Height: 640);
          Background: #0b111c(0.82);

          Group #Rings {
            Anchor: (Left: 0, Top: 0, Width: 640, Height: 640);

