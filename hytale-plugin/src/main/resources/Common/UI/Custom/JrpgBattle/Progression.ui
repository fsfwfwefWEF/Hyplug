            Group #G23Icon { Anchor: (Left: 14, Top: 14, Width: 40, Height: 40); }
          }
          Group #G24 {
            Anchor: (Left: 145, Top: 43, Width: 68, Height: 68);

            Group #G24Sel { Anchor: (Left: 0, Top: 0, Width: 68, Height: 68); Background: #ffffff(0.9); }
            Group #G24Lock { Anchor: (Left: 2, Top: 2, Width: 64, Height: 64); Background: #1a2030(0.95); }
            Group #G24Avail { Anchor: (Left: 2, Top: 2, Width: 64, Height: 64); Background: #3d7bd9; }
            Group #G24Open { Anchor: (Left: 2, Top: 2, Width: 64, Height: 64); Background: #e8c46a; }
            $C.@SecondaryTextButton #G24Btn { @Text = ""; Anchor: (Left: 5, Top: 5, Width: 58, Height: 58); }
            Group #G24Icon { Anchor: (Left: 14, Top: 14, Width: 40, Height: 40); }
          }
        }
        Group { Anchor: (Width: 10); }
        Group #DetailCol {
          FlexWeight: 1;
          LayoutMode: Top;
          Background: #141d2e(0.88);
          Padding: (Full: 10);

          Group {
            Anchor: (Height: 44);
            LayoutMode: Left;

            Group #SelIcon { Anchor: (Width: 40, Height: 40); }
            Group { Anchor: (Width: 8); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;

              Label #SelTitle {
                Text: "";
                Anchor: (Height: 22);
                Style: (FontSize: 16, TextColor: #e8c46a, RenderBold: true);
              }
              Label #SelKind {
                Text: "";
                Anchor: (Height: 18);
                Style: (FontSize: 12, TextColor: #9fb0c6);
              }
            }
          }
          Group { Anchor: (Height: 6); }
          Label #SelText {
            Text: "";
            FlexWeight: 1;
            Style: (FontSize: 12, TextColor: #e9eef6, Wrap: true);
          }
          Group {
            Anchor: (Height: 30);
            LayoutMode: Left;

            $C.@SecondaryTextButton #PrevNode { @Text = "<"; Anchor: (Width: 60, Height: 28); }
            Group { Anchor: (Width: 6); }
            Label {
              Text: "соседние узлы";
              Anchor: (Height: 28);
              FlexWeight: 1;
              Style: (FontSize: 12, TextColor: #9fb0c6);
            }
            $C.@SecondaryTextButton #NextNode { @Text = ">"; Anchor: (Width: 60, Height: 28); }
          }
          Group { Anchor: (Height: 6); }
          $C.@SecondaryTextButton #Learn { @Text = "Открыть узел"; Anchor: (Width: 250, Height: 34); }
          Group { Anchor: (Height: 4); }
          Label #Message {
            Text: "";
            Anchor: (Height: 36);
            Style: (FontSize: 12, TextColor: #ffd27a, Wrap: true);
          }
          Group { Anchor: (Height: 4); }
          $C.@CancelTextButton #Close { @Text = "Закрыть"; Anchor: (Width: 250, Height: 32); }
        }
      }
    }
    Group { FlexWeight: 1; }
  }
  Group { FlexWeight: 1; }
}
