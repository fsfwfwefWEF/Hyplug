$C = "../Common.ui";

// Круговая сетка навыков. Собрано tools/gen_battle_ui.py — правь скрипт.
// Узел #G<n>: слои #G<n>Sel (выбран), #G<n>Lock/Avail/Open (состояние), кнопка #G<n>Btn, иконка #G<n>Icon.
// Рёбра: серые точки #EdgesOff всегда, золотые #Edge<k> — когда оба конца открыты.

Group {
  LayoutMode: Top;

  Group { FlexWeight: 1; }
  Group {
    Anchor: (Height: 946);
    LayoutMode: Left;

    Group { FlexWeight: 1; }
    Group #WindowSlot {
      Anchor: (Width: 1400);

      Group #Window {
        Anchor: (Left: 0, Top: 0, Width: 1400, Height: 946);
        LayoutMode: Top;
        Background: (TexturePath: "jr_window.png", Border: 86);
        Padding: (Left: 24, Right: 24, Top: 16, Bottom: 24);

        Group {
          Anchor: (Height: 52);
          LayoutMode: Left;

          Group { FlexWeight: 1; }
          Group {
            Anchor: (Width: 560, Height: 52);
            LayoutMode: Top;
            Background: (TexturePath: "jr_banner.png");
            Padding: (Top: 6);

            Label {
              Text: "СЕТКА НАВЫКОВ";
              Anchor: (Height: 26);
              Style: (FontSize: 21, TextColor: #e8c46a, RenderBold: true, HorizontalAlignment: Center);
            }
            Label {
              Text: "открывай узлы рядом с уже открытыми";
              Anchor: (Height: 16);
              Style: (FontSize: 12, TextColor: #b4c2d6, HorizontalAlignment: Center);
            }
          }
          Group { FlexWeight: 1; }
        }
        Group #Tabs {
          Anchor: (Height: 34);
          LayoutMode: Left;

          $C.@SecondaryTextButton #Tab0 { @Text = ""; Anchor: (Width: 190, Height: 32); }
          Group { Anchor: (Width: 6); }
          $C.@SecondaryTextButton #Tab1 { @Text = ""; Anchor: (Width: 190, Height: 32); }
          Group { Anchor: (Width: 6); }
          $C.@SecondaryTextButton #Tab2 { @Text = ""; Anchor: (Width: 190, Height: 32); }
          Group { Anchor: (Width: 6); }
          Group { FlexWeight: 1; }
          Group #PointsBox {
            Anchor: (Width: 270, Height: 34);
            LayoutMode: Left;
            Background: (TexturePath: "jr_panel_gold.png", Border: 12);
            Padding: (Left: 8, Right: 8, Top: 4);

            Label #PointsNum {
              Text: "0";
              Anchor: (Width: 46, Height: 26);
              Style: (FontSize: 20, TextColor: #e8c46a, RenderBold: true, HorizontalAlignment: Center);
            }
            Group { Anchor: (Width: 6); }
            Label #Points {
              Text: "";
              Anchor: (Height: 26);
              FlexWeight: 1;
              Style: (FontSize: 13, TextColor: #e9eef6);
            }
          }
        }
        Group { Anchor: (Height: 8); }
        Group {
          Anchor: (Height: 800);
          LayoutMode: Left;

          Group #HeroCol {
            Anchor: (Width: 290);
            LayoutMode: Top;
            Background: (TexturePath: "jr_panel.png", Border: 22);
            Padding: (Full: 10);

            Group {
              Anchor: (Height: 92);
              LayoutMode: Left;

              Group #HeroIcon { Anchor: (Width: 88, Height: 88); }
              Group { Anchor: (Width: 10); }
              Group {
                FlexWeight: 1;
                LayoutMode: Top;

                Label #HeroName {
                  Text: "";
                  Anchor: (Height: 28);
                  Style: (FontSize: 20, TextColor: #a9d8ff, RenderBold: true);
                }
                Label #HeroTitle {
                  Text: "";
                  Anchor: (Height: 20);
                  Style: (FontSize: 13, TextColor: #e8c46a);
                }
                Label #HeroLevel {
                  Text: "";
                  Anchor: (Height: 36);
                  Style: (FontSize: 12, TextColor: #b4c2d6, Wrap: true);
                }
              }
            }
            Group #ExpBack {
              Anchor: (Width: 266, Height: 7);
              LayoutMode: Left;
              Background: (TexturePath: "jr_bar_back.png");
              Group #ExpFill { Anchor: (Width: 266, Height: 7); Background: (TexturePath: "jr_bar_ap.png"); }
            }
            Group { Anchor: (Height: 6); }
            Group { Anchor: (Height: 1); Background: #e8c46a(0.40); }
            Group { Anchor: (Height: 1); Background: #000000(0.35); }
            Group { Anchor: (Height: 6); }
            Label #HeroStats {
              Text: "";
              Anchor: (Height: 96);
              Style: (FontSize: 12, TextColor: #e9eef6, Wrap: true);
            }
            Label #HeroPassives {
              Text: "";
              Anchor: (Height: 60);
              Style: (FontSize: 12, TextColor: #c9a0ff, Wrap: true);
            }
            Label #Known {
              Text: "";
              FlexWeight: 1;
              Style: (FontSize: 12, TextColor: #b4c2d6, Wrap: true);
            }
            $C.@SecondaryTextButton #AddExp { @Text = "+100 опыта (тест)"; Anchor: (Width: 266, Height: 30); }
            Group { Anchor: (Height: 4); }
            $C.@SecondaryTextButton #Respec { @Text = "Сбросить сетку"; Anchor: (Width: 266, Height: 30); }
          }
          Group { Anchor: (Width: 10); }
