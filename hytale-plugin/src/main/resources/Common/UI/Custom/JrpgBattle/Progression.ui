              Text: "";
              Anchor: (Height: 34);
              FlexWeight: 1;
              Style: (FontSize: 15, TextColor: #e9eef6);
            }
            $C.@SecondaryTextButton #StatPlus3 { @Text = "+"; Anchor: (Width: 44, Height: 32); }
          }
          Group #StatRow4 {
