            Anchor: (Height: 20);
            Style: (FontSize: 12, TextColor: #9fb0c6);
          }
          Group #Node0 {
            Anchor: (Height: 86);
            LayoutMode: Left;
            Background: #141d2e(0.92);
            Padding: (Full: 6);

