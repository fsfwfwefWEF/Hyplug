$C = "../Common.ui";

// Меню героя: вкладки #Tab0..2, кукла — слоты #D0..7 (индекс = Equipment.Slot), рюкзак #S0..23 с вкладками
// #BTab0..5, карточка вещи (#SelIcon, #SelName, #SelKind, #Info0..7, гнёзда #Sock0..2), кнопки #Act/#Cancel/#Back/#Close.
// #<ячейка>Glow — куда можно положить выбранное. Собрано tools/gen_battle_ui.py — правь скрипт.

Group {
  LayoutMode: Top;

  Group { FlexWeight: 1; }
  Group {
    Anchor: (Height: 626);
    LayoutMode: Left;

    Group { FlexWeight: 1; }
    Group #WindowSlot {
