$C = "../Common.ui";

// Кузница: вещи #L0..8 (#L<n>Btn/#L<n>Icon/#L<n>Q/#L<n>Sel), карточка (#SelIcon, #SelName, #SelKind, #Info0..7,
// гнёзда #Sock0..2 с кнопками #Ext0..2 и сетка #SockGrid), улучшение #UpCost/#Upgrade, камни — сетка #GemGrid,
// #GemSel, #Insert, #Merge, #Close.
// Собрано tools/gen_battle_ui.py — правь скрипт.

Group {
  LayoutMode: Top;

  Group { FlexWeight: 1; }
