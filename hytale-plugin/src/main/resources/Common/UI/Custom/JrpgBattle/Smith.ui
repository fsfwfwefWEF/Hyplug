              Group { Anchor: (Left: 76, Top: 0, Width: 64, Height: 64); Background: (TexturePath: "jr_cell.png", Border: 24); }
              Group { Anchor: (Left: 152, Top: 0, Width: 64, Height: 64); Background: (TexturePath: "jr_cell.png", Border: 24); }
              ItemGrid #SockGrid { Anchor: (Left: 0, Top: 0, Width: 216, Height: 64); SlotsPerRow: 3; InventorySectionId: -1111; AreItemsDraggable: true; RenderItemQualityBackground: false; InfoDisplay: Tooltip; Style: (SlotSize: 64, SlotIconSize: 48, SlotSpacing: 12, SlotBackground: "jr_clear.png"); }
