                Text: "";
                Anchor: (Height: 20);
                Style: (FontSize: 12, TextColor: #9fb0c6);
              }
            }
          }
          Group { Anchor: (Height: 8); }
          Label #SelText {
            Text: "";
            FlexWeight: 1;
            Style: (FontSize: 13, TextColor: #e9eef6, Wrap: true);
          }
          Label #Message {
            Text: "";
            Anchor: (Height: 36);
            Style: (FontSize: 12, TextColor: #ffd27a, Wrap: true);
          }
          $C.@SecondaryTextButton #Drop { @Text = "Выбросить 1"; Anchor: (Width: 300, Height: 32); }
          Group { Anchor: (Height: 6); }
          $C.@CancelTextButton #Close { @Text = "Закрыть"; Anchor: (Width: 300, Height: 32); }
        }
      }
    }
    Group { FlexWeight: 1; }
  }
  Group { FlexWeight: 1; }
}
