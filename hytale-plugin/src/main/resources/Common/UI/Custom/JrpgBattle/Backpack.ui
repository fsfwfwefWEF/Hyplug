$C = "../Common.ui";

// Рюкзак: вкладки-фильтры #Tab0..4, сортировка #SortKind/#SortName/#SortCount, ячейки #S<n>
// (#S<n>Sel — выбрана, #S<n>Btn — кнопка, #S<n>Icon — иконка, #S<n>Count — количество).
// Собрано tools/gen_battle_ui.py — правь скрипт.

Group {
  LayoutMode: Top;

  Group { FlexWeight: 1; }
  Group {
    Anchor: (Height: 514);
    LayoutMode: Left;

    Group { FlexWeight: 1; }
    Group #Window {
      Anchor: (Width: 1000);
      LayoutMode: Top;
      Background: #070b12(0.95);
      Padding: (Full: 12);

      Group {
        Anchor: (Height: 32);
        LayoutMode: Left;

        Label {
          Text: "РЮКЗАК";
          Anchor: (Height: 30);
          FlexWeight: 1;
          Style: (FontSize: 22, TextColor: #e8c46a, RenderBold: true);
        }
        Label #Total {
          Text: "";
          Anchor: (Width: 360, Height: 30);
          Style: (FontSize: 13, TextColor: #9fb0c6);
        }
      }
      Group #Tabs {
        Anchor: (Height: 34);
        LayoutMode: Left;

        $C.@SecondaryTextButton #Tab0 { @Text = "Все"; Anchor: (Width: 112, Height: 32); }
        Group { Anchor: (Width: 5); }
        $C.@SecondaryTextButton #Tab1 { @Text = "Зелья"; Anchor: (Width: 112, Height: 32); }
        Group { Anchor: (Width: 5); }
        $C.@SecondaryTextButton #Tab2 { @Text = "Боевые"; Anchor: (Width: 112, Height: 32); }
        Group { Anchor: (Width: 5); }
        $C.@SecondaryTextButton #Tab3 { @Text = "Материалы"; Anchor: (Width: 112, Height: 32); }
        Group { Anchor: (Width: 5); }
        $C.@SecondaryTextButton #Tab4 { @Text = "Снаряжение"; Anchor: (Width: 112, Height: 32); }
        Group { Anchor: (Width: 5); }
        Group { FlexWeight: 1; }
        Label {
          Text: "Сортировка:";
          Anchor: (Width: 100, Height: 32);
          Style: (FontSize: 13, TextColor: #9fb0c6);
        }
        $C.@SecondaryTextButton #SortKind { @Text = "Тип"; Anchor: (Width: 96, Height: 32); }
        Group { Anchor: (Width: 4); }
        $C.@SecondaryTextButton #SortName { @Text = "Имя"; Anchor: (Width: 96, Height: 32); }
        Group { Anchor: (Width: 4); }
        $C.@SecondaryTextButton #SortCount { @Text = "Кол-во"; Anchor: (Width: 96, Height: 32); }
        Group { Anchor: (Width: 4); }
      }
      Group { Anchor: (Height: 8); }
      Group {
        Anchor: (Height: 428);
        LayoutMode: Left;

        Group #GridCol {
          Anchor: (Width: 536);
          LayoutMode: Top;
